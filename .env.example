# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# Tracking IDs (from ProJyotish)
# Google Tag Manager
VITE_GTM_ID="GTM-XXXXXXX"

# Google Analytics 4
VITE_GA4_ID="G-XXXXXXXXXX"

# Meta (Facebook) Pixel
VITE_META_PIXEL_ID="000000000000000"

# Microsoft Clarity
VITE_CLARITY_ID="xxxxxxxxxx"

# PostHog Analytics
VITE_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxx"
VITE_POSTHOG_HOST="https://app.posthog.com"

# Reddit Pixel
VITE_REDDIT_PIXEL_ID="a2_xxxxxxxxxxx"

# WhatsApp URL for floating CTA
VITE_WHATSAPP_URL="https://wa.me/919560057789?text=Hi"

# Peak Nest API base (include global prefix: development | staging | production)
# Local:  http://localhost:3100/development
# Prod:   https://api.peaklife.me/production
VITE_API_BASE_URL="http://localhost:3100/development"

# Razorpay (checkout). Subscription path: {VITE_API_BASE_URL}/payments/razorpay/subscription
VITE_RAZORPAY_KEY_ID="your_razorpay_key_id"
